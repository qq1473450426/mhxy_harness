# ============================================================
# 环境变量示例 - 复制为 .env 后按需修改
# ============================================================

# 日志/数据目录(默认 ./logs ./replay)
MHXY_LOG_DIR=./logs
MHXY_REPLAY_DIR=./replay

# 本地 LLM(Ollama 默认)
MHXY_LLM_PROVIDER=ollama
MHXY_LLM_MODEL=qwen2.5:7b
MHXY_OLLAMA_BASE_URL=http://127.0.0.1:11434

# 嵌入模型(Phase 3 RAG)
MHXY_EMBEDDING_MODEL=bge-m3

# 知识库路径(指向 xyq-skills 克隆)
MHXY_KNOWLEDGE_REPO=D:/project/python/mhxy_ai/xyq-skills

# WebUI
MHXY_UI_HOST=127.0.0.1
MHXY_UI_PORT=8080
